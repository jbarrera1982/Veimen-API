# Copiar este archivo a .env y completar con los valores reales.
# NUNCA subas el archivo .env al repositorio.

ASPNETCORE_ENVIRONMENT=Production

# Cadena de conexión a MySQL (obligatoria).
CONNECTION_STRING=Server=host;Port=3306;Database=database;Uid=user;Pwd=password;AllowPublicKeyRetrieval=true;SslMode=Required;DateTimeKind=Utc;

# JWT (obligatorio: JWT_SECRET debe tener al menos 32 caracteres).
JWT_SECRET=pon_aqui_una_clave_secreta_aleatoria_de_al_menos_32_caracteres
JWT_ISSUER=VeimenAPI
JWT_AUDIENCE=VeimenAPIClients

# Orígenes permitidos por CORS, separados por ';'.
CORS_ALLOWED_ORIGINS=http://localhost:4200;http://www.veimen.net;https://www.veimen.net

# OpenAI (costos y consumo de la organización).
OPENAI_BASE_URL=https://api.openai.com
OPENAI_ADMIN_KEY=sk-admin-pon_aqui_tu_admin_key_de_openai

# Buzón IMAP que se escanea para generar requerimientos.
IMAP_HOST=vda3700.is.cc
IMAP_PORT=993
IMAP_USERNAME=usuario@tudominio.com
IMAP_PASSWORD=contrasena_del_buzon
IMAP_USE_SSL=true
IMAP_CLIENT_ID=1

# Webhook de n8n para el informe de auditoría.
N8N_AUDIT_WEBHOOK_URL=https://n8n.veimen.net/webhook/auditar-solicitud
